# === LLM 调用（演示模式可不填） ===
# OpenAI 兼容协议；baseURL 与 model 由你的代理/平台决定
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-replace-with-your-real-key
LLM_MODEL=MiniMax-M3

# === 演示模式开关 ===
# DEMO_MODE=1 → 所有外部依赖短路，零成本、确定性。CI / E2E 默认开启。
# LLM_MOCK=1 → 仅 API 路由短路 LLM（前端 UI 仍走真实表单）。
# 不设置 + 配 Key → 调用真实模型。
DEMO_MODE=1
LLM_MOCK=1
